---
import Docs from '../../layouts/Docs.astro';
import Icon from 'plume-icons/astro';
import { iconNames, type IconName } from 'plume-icons';
import meta from 'plume-icons/meta.json';
const m = meta.icons as Record<string, { phosphor?: string[]; lucide?: string[] }>;
const rows = iconNames.map((n) => ({ name: n as IconName, phosphor: m[n].phosphor ?? [], lucide: m[n].lucide ?? [] }));
---

<Docs title="From Phosphor or Lucide" description="Phosphor and Lucide icon names and their Plume equivalents.">
  <p>Find the Plume icon for a Phosphor or Lucide name. Plume names describe the picture, so a few differ (Phosphor <code>gear-six</code> and Lucide <code>settings</code> are both <code>gear</code>).</p>
  <label class="find">
    <span class="sr-only">Filter names</span>
    <input id="find" type="search" placeholder="Type a Phosphor, Lucide or Plume name" autocomplete="off" />
  </label>
  <table>
    <thead><tr><th>Plume</th><th>Phosphor</th><th>Lucide</th></tr></thead>
    <tbody id="rows">
      {rows.map((r) => (
        <tr data-k={[r.name, ...r.phosphor, ...r.lucide].join(' ')}>
          <td><span class="nm"><Icon name={r.name} size={18} /><code>{r.name}</code></span></td>
          <td>{r.phosphor.join(', ')}</td>
          <td>{r.lucide.join(', ')}</td>
        </tr>
      ))}
    </tbody>
  </table>
  <script>
    const input = document.getElementById('find') as HTMLInputElement;
    const rows = [...document.querySelectorAll<HTMLTableRowElement>('#rows tr')];
    input.addEventListener('input', () => {
      const q = input.value.toLowerCase().trim();
      for (const r of rows) r.hidden = !!q && !r.dataset.k!.toLowerCase().includes(q);
    });
  </script>
  <style>
    .find input { width: 100%; height: 40px; padding: 0 12px; border: 1px solid var(--line); border-radius: 8px; background: var(--panel); color: var(--text); font: inherit; }
    .nm { display: inline-flex; align-items: center; gap: 8px; }
  </style>
</Docs>
