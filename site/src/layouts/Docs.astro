---
import Base from './Base.astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const here = Astro.url.pathname.replace(/\/$/, '');
const pages = [
  { href: '/docs', label: 'Getting started' },
  { href: '/docs/react', label: 'React and Next.js' },
  { href: '/docs/astro', label: 'Astro' },
  { href: '/docs/svg', label: 'SVG and vanilla JS' },
  { href: '/docs/iconify', label: 'Iconify and astro-icon' },
  { href: '/docs/style', label: 'Style guide' },
  { href: '/docs/migrate', label: 'From Phosphor or Lucide' },
];
---

<Base title={`${title} · Plume Icons`} description={description}>
  <div class="docs">
    <nav class="side" aria-label="Docs">
      {pages.map((p) => <a href={`${base}${p.href}/`} aria-current={here === `${base}${p.href}` ? 'page' : undefined}>{p.label}</a>)}
    </nav>
    <article>
      <h1>{title}</h1>
      <slot />
    </article>
  </div>
  <style>
    .docs { max-width: 1100px; margin: 0 auto; padding: 32px 24px; display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 48px; }
    .side { position: sticky; top: 88px; align-self: start; display: flex; flex-direction: column; gap: 2px; }
    .side a { padding: 6px 10px; border-radius: 8px; color: var(--muted); text-decoration: none; }
    .side a:hover, .side a[aria-current] { color: var(--text); background: var(--raised); }
    article { max-width: 720px; }
    article :global(h1) { font-size: 32px; line-height: 40px; font-weight: 600; letter-spacing: -0.01em; margin: 0 0 16px; }
    article :global(h2) { font-size: 20px; line-height: 28px; font-weight: 600; margin: 36px 0 8px; }
    article :global(h3) { font-size: 16px; font-weight: 600; margin: 24px 0 6px; }
    article :global(p), article :global(li) { color: var(--text-2); line-height: 22px; }
    article :global(table) { width: 100%; border-collapse: collapse; font-size: 13px; margin: 12px 0; }
    article :global(th), article :global(td) { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line-soft); vertical-align: top; }
    article :global(th) { color: var(--muted); font-weight: 500; }
    @media (max-width: 760px) {
      .docs { grid-template-columns: 1fr; gap: 16px; padding: 20px 12px; }
      .side { position: static; flex-direction: row; flex-wrap: wrap; }
    }
  </style>
</Base>
